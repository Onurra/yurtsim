{
  "name": "yurtsim",
  "version": "1.0.0",
  "description": "Yurt Simülatör — Türk üniversite hayatı temalı yaşam simülasyonu (vanilla JS + Capacitor paketleme).",
  "private": true,
  "scripts": {
    "build:www": "node build/www.js",
    "smoke": "node build/smoke.js",
    "sync": "npm run build:www && cap sync",
    "copy": "npm run build:www && cap copy",
    "assets": "capacitor-assets generate --android --ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios"
  },
  "author": "Onur",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5"
  }
}
