www/
.gradle/
*.iml

# Capacitor native projeleri — ÜRETİLEN, kaynak değil.
# ios/ her Codemagic build'inde `npx cap add ios` ile yeniden üretilir (codemagic.yaml).
# android/ da yerelde `npx cap add android` ile üretilir.
ios/
android/

# Codemagic/xcodebuild çıktıları (CI'da oluşur)
build/ios-dd/
build/ios/
build/ipa/
build/*.ipa

# Refaktör/doğrulama artıkları (üretime dahil değil — build/ scriptleri tutulur)
build/shot-*.png
build/_*.html
build/_*.txt

# Eski monolit yedeği (yerelde durur, izlenmez)
yurtsim (2).html

# Ikon onizleme cikti klasoru (build/icon.js --preview)
build/_icon-preview/
cert_key.pem
